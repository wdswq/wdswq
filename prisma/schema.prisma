// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  firstName String?
  lastName  String?
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  knowledgeItems  KnowledgeItem[]
  fileAssets      FileAsset[]
  uploadJobs      UploadJob[]
  embeddingRecords EmbeddingRecord[]
  linkBookmarks   LinkBookmark[]

  @@map("users")
}

model KnowledgeItem {
  id          String   @id @default(cuid())
  title       String
  content     String
  summary     String?
  userId      String
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?       @relation(fields: [categoryId], references: [id])
  tags       KnowledgeItemTag[]
  fileAssets FileAsset[]
  bookmarks  LinkBookmark[]
  embeddings EmbeddingRecord[]

  @@map("knowledge_items")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  knowledgeItems KnowledgeItem[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  knowledgeItems KnowledgeItemTag[]

  @@map("tags")
}

model KnowledgeItemTag {
  knowledgeItemId String
  tagId           String

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([knowledgeItemId, tagId])
  @@map("knowledge_item_tags")
}

model FileAsset {
  id             String   @id @default(cuid())
  filename       String
  originalName   String
  mimeType       String
  size           Int
  path           String
  userId         String
  knowledgeItemId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeItem KnowledgeItem? @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@map("file_assets")
}

model LinkBookmark {
  id             String   @id @default(cuid())
  url            String
  title          String?
  description    String?
  favicon        String?
  knowledgeItemId String
  userId         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("link_bookmarks")
}

model EmbeddingRecord {
  id             String   @id @default(cuid())
  knowledgeItemId String
  userId         String
  vector         Float[]
  model          String
  dimensions     Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("embedding_records")
}

model UploadJob {
  id            String   @id @default(cuid())
  userId        String
  filename      String
  status        String   @default("pending") // pending, processing, completed, failed
  progress      Int      @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upload_jobs")
}